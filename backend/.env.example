# Copy this file to ".env" (same folder) and fill in what you have. Never commit ".env" or share its contents.
# Anything left empty simply stays switched off.

# --- Text AI + Vision AI + Circle to Ask (Groq) — console.groq.com → API Keys
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Image AI + Speech-to-text + Text-to-speech (Cloudflare Workers AI, keep the account on the FREE plan)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Video AI (Pollinations, experimental; works without a key but is heavily rate-limited).
#     Groq and Cloudflare have no video model. Video is OFF until an admin switches it on (Admin -> AI -> Video AI).
#     PUBLIC_BASE_URL=https://your-site.example   (only needed for photo-to-video)
VIDEO_API_KEY=

# --- 3D Studio: single-photo AI (Tripo) — platform.tripo3d.com → API Keys. Meshy is switched off.
TRIPO_API_KEY=
# TRIPO_MODEL=v3.1-20260211
